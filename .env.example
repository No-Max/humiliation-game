# Database (local Docker — see npm run db:up)
DATABASE_URL="postgresql://game:game@localhost:5432/humiliation_game"

# Prod DB locally: npm run db:prod:env → db:prod:tunnel → db:prod:studio
# Credentials land in .env.prod.local (gitignored), port 5433 via SSH tunnel.

# Server
PORT=3200
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3210,http://localhost:3220

# Media
UPLOAD_DIR=uploads
# Default 10MB for question images
MAX_UPLOAD_SIZE=10485760
# Answer reveal media (images, audio, video) — 5MB
MAX_ANSWER_MEDIA_UPLOAD_SIZE=5242880
