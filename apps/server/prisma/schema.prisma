generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum SeriesStatus {
  DRAFT
  PUBLISHED
}

enum QuestionContentType {
  IMAGE
  TEXT
  QUOTE
  LYRICS
  EMOJI
  IMAGE_TEXT
}

enum AnswerType {
  CHOICE
  TEXT
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TeamAccount {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gameTeams GameTeam[]
}

model Series {
  id          String       @id @default(cuid())
  title       String
  number      Int
  description String?
  coverUrl    String?
  status      SeriesStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  seriesTours SeriesTour[]
  questions   Question[]
  rooms       GameRoom[]

  @@unique([number])
}

model SeriesTour {
  id        String   @id @default(cuid())
  seriesId  String
  tourId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([seriesId, tourId])
  @@index([seriesId])
  @@index([tourId])
}

model Tour {
  id                  String   @id @default(cuid())
  title               String
  rules               String?
  mediaUrls           String[] @default([])
  defaultPoints       Int      @default(3)
  defaultTimeLimitSec Int      @default(60)
  limitQuestionsToTeamCount Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  questions   Question[]
  seriesTours SeriesTour[]

  @@index([title])
}

model Question {
  id                 String              @id @default(cuid())
  tourId             String
  seriesId           String
  sortOrder          Int                 @default(0)
  contentType        QuestionContentType @default(TEXT)
  prompt             String?
  mediaUrls          String[]            @default([])
  answerType         AnswerType          @default(TEXT)
  choices            String[]            @default([])
  correctAnswer      String
  acceptableAnswers  String[]            @default([])
  hints              String[]            @default([])
  points             Int?
  timeLimitSec       Int?
  answerMedia        Json                @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([seriesId])
  @@index([tourId, seriesId])
}

model GameRoom {
  id        String     @id @default(cuid())
  code      String     @unique
  seriesId  String
  status    RoomStatus @default(WAITING)
  hostTeamId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  series Series     @relation(fields: [seriesId], references: [id])
  teams  GameTeam[]
}

model GameTeam {
  id            String  @id @default(cuid())
  roomId        String
  teamAccountId String?
  name          String
  logoUrl       String?
  score         Int     @default(0)
  sortOrder     Int     @default(0)
  connected     Boolean @default(false)

  room        GameRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teamAccount TeamAccount? @relation(fields: [teamAccountId], references: [id])

  @@index([roomId])
}

model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
